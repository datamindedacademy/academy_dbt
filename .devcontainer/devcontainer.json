{
    "name": "Academy dbt codespace",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    
    // Forward DB (5432) and pgAdmin (5052)
    "forwardPorts": [5052, 5432],

    "containerEnv": {
        "SHELL": "/bin/bash"
    },

    "customizations": {
        "vscode": {
            "settings": {
                // .sql files can be used by both SQLTools as well as by dbt.
                // This is kind of annoying.
                // To make it work nicely, we treat .sql files inside common dbt directories as dbt code
                // and everything else (e.g. SQLTools scratchpads) as regular sql
                "files.associations": {
                    "**/analyses/**/*.sql": "jinja-sql",
                    "**/models/**/*.sql": "jinja-sql",
                    "**/macros/**/*.sql": "jinja-sql",
                    "**/tests/**/*.sql": "jinja-sql"
                },
                "sqltools.connections": [
                    {
                        "previewLimit": 50,
                        "server": "db",
                        "port": 5432,
                        "driver": "PostgreSQL",
                        "name": "postgres",
                        "database": "postgres",
                        "username": "postgres",
                        "password": "postgres"
                    }
                ],
                "sqltools.codelensLanguages": ["sql"],
                "sqltools.completionLanguages": ["sql", "sql-postgres"]
            },
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "samuelcolvin.jinjahtml",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                // SQL client for the Snowflake backend; SQLTools only has a
                // Postgres driver here. Reads ~/.snowflake/connections.toml,
                // which create_profiles.sh writes.
                "snowflake.snowflake-vsc"
            ]
        }
    },
    
    "remoteUser": "vscode"
}