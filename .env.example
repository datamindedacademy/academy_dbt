# Course credentials and settings.
# Copy this file to `.env` and fill in your own values, then run:
#   ./create_profiles.sh
# `.env` is gitignored — never commit your token.
#
# Where to find each value: see docs/setup_instructions.md

# --- Databricks (needed only for the Databricks target) --------------------

# Your workspace URL, with or without https://
# (e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com)
DATABRICKS_HOST=

# Connection details of the "Serverless Starter Warehouse"
# (SQL Warehouses > Serverless Starter Warehouse > Connection details > HTTP path)
DATABRICKS_HTTP_PATH=

# A personal access token
# (Settings > Developer > Access tokens > Manage > Generate new token)
DATABRICKS_TOKEN=

# --- Optional overrides ----------------------------------------------------
# The defaults below work in the codespace. Change them only if you know why.

# Where dbt writes your models on Databricks
#DATABRICKS_CATALOG=workspace
#DATABRICKS_SCHEMA=dbt

# The Postgres database in the codespace
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#POSTGRES_DBNAME=postgres

# Where dbt writes your models on Postgres.
# Keep this different from the source schema (tpch), otherwise a model named
# e.g. "customer" replaces the raw source table of the same name.
#POSTGRES_SCHEMA=dbt

# --- Snowflake (needed only for the Snowflake target) ----------------------
# Snowflake stops password sign-in for dbt on 2026-08-31. Use key-pair
# authentication. It also skips MFA, which is why it is the supported way to
# connect a tool like dbt.
#
# Create a key pair (see docs/setup_instructions.md for the full steps):
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -nocrypt -out ~/.snowflake/rsa_key.p8
#   openssl rsa -in ~/.snowflake/rsa_key.p8 -pubout -out ~/.snowflake/rsa_key.pub
# Then an admin registers the public key on your Snowflake user.

#SNOWFLAKE_ACCOUNT=
#SNOWFLAKE_USER=
#SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
#SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
#SNOWFLAKE_ROLE=
#SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# The database dbt WRITES to. The TPC-H source data is read from
# SNOWFLAKE_SAMPLE_DATA.TPCH_SF1, which every account has.
#SNOWFLAKE_DATABASE=
#SNOWFLAKE_SCHEMA=dbt

# Legacy password sign-in. It stops working on 2026-08-31. Prefer key-pair.
#SNOWFLAKE_PASSWORD=
