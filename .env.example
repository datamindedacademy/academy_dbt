# Course credentials and settings.
# Copy this file to `.env` and fill in your own values, then run:
#   ./create_profiles.sh
# `.env` is gitignored — never commit your token.
#
# Where to find each value: see docs/setup_instructions.md

# --- Databricks (needed only for the Databricks target) --------------------

# Your workspace URL, with or without https://
# (e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com)
DATABRICKS_HOST=

# Connection details of the "Serverless Starter Warehouse"
# (SQL Warehouses > Serverless Starter Warehouse > Connection details > HTTP path)
DATABRICKS_HTTP_PATH=

# A personal access token
# (Settings > Developer > Access tokens > Manage > Generate new token)
DATABRICKS_TOKEN=

# --- Snowflake -------------------------------------------------------------
#
# Works with any Snowflake account. If your instructor set up a classroom they
# hand you a filled-in file instead, and you can ignore the rest of this block.

#SNOWFLAKE_ACCOUNT=            # e.g. myorg-myaccount
#SNOWFLAKE_USER=
#SNOWFLAKE_ROLE=
#SNOWFLAKE_WAREHOUSE=
#SNOWFLAKE_DATABASE=
#SNOWFLAKE_SCHEMA=             # where your models are written

# Then one of the following two. See docs/setup_instructions.md.
#
# 1. An access token or password. A classroom handout puts the programmatic
#    access token here; on your own account a PAT works the same way.
#SNOWFLAKE_PASSWORD=
#
# 2. A key pair, if you would rather not use a token.
#    https://docs.snowflake.com/en/user-guide/key-pair-auth
#SNOWFLAKE_PRIVATE_KEY_PATH=

# --- Optional overrides ----------------------------------------------------
# The defaults below work in the codespace. Change them only if you know why.

# Where dbt writes your models on Databricks
#DATABRICKS_CATALOG=workspace
#DATABRICKS_SCHEMA=dbt

# The Postgres database in the codespace
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#POSTGRES_DBNAME=postgres

# Where dbt writes your models on Postgres.
# Keep this different from the source schema (tpch), otherwise a model named
# e.g. "customer" replaces the raw source table of the same name.
#POSTGRES_SCHEMA=dbt
